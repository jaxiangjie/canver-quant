node_modules/
build/
dist/
data/*
# 内嵌的静态参考行情（parquet）需随仓库提交，保证 clone 即可跑真实回测、数据自包含
# 注意：必须用 data/* 而非 data/，否则被排除目录下的内容无法用 ! 重新纳入
!data/parquet/
!data/parquet/daily/
!data/parquet/daily/*.parquet
# 估值快照库与历史回补数据同样随仓库提交（clone 即可算分位，无需重新抓取）
!data/valuation/
!data/valuation/*.jsonl
# 自选组合库（服务端持久化，随 git 提交做版本管理）
!data/portfolios/
!data/portfolios/*.json
# 统一池 registry（staging 晋升标的的元数据，随 git 版本管理）
!data/pool_registry.json
.DS_Store
*.log
.env*
!.env.example
# 本地验收/诊断脚本与截图（CDP 验收工具产物）
logs/
